# ─────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# Razorpay API Keys
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Use test keys (rzp_test_...) for development
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Allowed origins for browser requests (comma-separated)
# Add your production frontend URL(s)
CORS_ORIGINS=http://localhost:3000,https://sitescapr.vercel.app

# Shared secret used by /internal/update-indices endpoint (n8n)
PIPELINE_SECRET=YOUR_LONG_RANDOM_SECRET

# Optional: switch to managed Postgres in production
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/sitescapr
