# n8n runtime environment for SiteScapr live pipeline

# Deployed backend base URL (no trailing slash)
SITESCAPR_BACKEND_URL=https://your-backend-domain

# Must match backend PIPELINE_SECRET exactly
PIPELINE_SECRET=replace_with_long_random_secret

# Third-party API keys
NEWSAPI_KEY=replace_with_newsapi_key
GROQ_API_KEY=replace_with_groq_key
